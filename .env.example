# Chép file này thành .env rồi điền (Windows: copy .env.example .env · macOS/Linux: cp .env.example .env).
# KHÔNG commit .env (đã có trong .gitignore). Không dán key vào code, slide, ảnh chụp màn hình.
# BTC KHÔNG cấp API key: dùng gói miễn phí hoặc tài khoản của nhóm (xem docs/connect-model.md).
# MODEL_PROVIDER: để trống hoặc fake = chế độ giả · openrouter / gemini / openai / anthropic
# OpenRouter: MODEL_PROVIDER=openrouter; MODEL_NAME là ID đầy đủ từ trang model (nhà_cung_cấp/tên_model).
# API_KEY là key OpenRouter khi dùng MODEL_PROVIDER=openrouter.
# MODEL_NAME: mã gọi API của model, đúng như tài liệu nhà cung cấp.
MODEL_PROVIDER=
MODEL_NAME=
API_KEY=

# Portal giả: chạy python codebase/portal_api.py trước khi hỏi thông tin riêng.
PORTAL_API_URL=http://127.0.0.1:8765
# Tùy chọn; mặc định runtime/portal_tokens.json. Không commit file token.
PORTAL_TOKENS_FILE=

# Discord: chỉ dùng server thử nghiệm
DISCORD_BOT_TOKEN=token_bot_cua_ban
DISCORD_GUILD_ID=id_server
DISCORD_QA_CHANNEL_ID=id_kenh_hoi_dap
DISCORD_REVIEW_CHANNEL_ID=id_kenh_duyet
DISCORD_COACH_DATA_CHANNEL_ID=

DISCORD_LEARNER_ROLE_ID=id_role_learner
DISCORD_LAB_COACH_ROLE_ID=id_role_lab_coach
